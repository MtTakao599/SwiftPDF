<?xml version="1.0" encoding="utf-8"?>
<!--
  SwiftPDF MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build pdfcraft.wxs installer-ui.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d ModelsDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files\SwiftPDF. Start Menu and desktop shortcuts are named
  SwiftPDF. App Paths, the PDF ProgID and RegisteredApplications are SwiftPDF's own keys.
  SwiftPDF is offered under "Open with" and in Default apps, and never replaces the existing
  default for .pdf. An optional "Open with SwiftPDF" entry is added to the PDF right-click menu.
  This package does not register edit or create-PDF commands, and it does not read or write
  PdfCraft's UpgradeCode, component ids, install folder or registry keys.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="SwiftPDF"
      Manufacturer="SwiftPDF"
      Version="$(var.Version)"
      UpgradeCode="2BE82895-B377-4701-A51F-E03759ECEF56"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <!-- WiX requires a non-empty Manufacturer. Windows shows it as the publisher in
         Apps & Features. SwiftPDF is the product name used there; it is not a legal entity,
         and no personal or company name is invented for this package. -->
    <SummaryInformation Description="SwiftPDF" Manufacturer="SwiftPDF" />
    <!-- HKLM registrations must never point into a per-user installation. Allow removal
         of an existing SwiftPDF installation even if an older MSI let it install per-user. -->
    <Launch Condition="ALLUSERS = 1 OR (Installed AND REMOVE = &quot;ALL&quot;)"
        Message="SwiftPDF must be installed for all users. Run setup with administrator privileges and ALLUSERS=1; per-user installation is not supported." />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of SwiftPDF is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Windows Installer requires an Icon id ending in .ico or .exe, or advertised shortcuts and
         Add/Remove Programs show a blank icon. -->
    <Icon Id="SwiftPdfIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="SwiftPdfIcon.ico" />
    <!-- No support site, Discord or update page. Those ARP links are omitted so Apps & Features
         does not send people to ArtCraft or PdfCraft. -->
    <!-- Desktop shortcut: on by default for a first install, a checkbox in the full-UI
         welcome dialog, and INSTALLDESKTOPSHORTCUT=0 on the msiexec command line for unattended
         installs. Secure, so the choice made in the (unelevated) UI reaches the elevated install.
         An update keeps the shortcut only if it is still on the desktop. A value given on the
         command line wins. -->
    <Property Id="INSTALLDESKTOPSHORTCUT" Secure="yes" />
    <Property Id="EXISTINGDESKTOPSHORTCUT">
      <DirectorySearch Id="DesktopSearch" Path="[DesktopFolder]" Depth="0">
        <FileSearch Name="SwiftPDF.lnk" />
      </DirectorySearch>
    </Property>
    <SetProperty Id="INSTALLDESKTOPSHORTCUT" Value="1" After="AppSearch" Sequence="first"
        Condition="NOT INSTALLDESKTOPSHORTCUT AND (NOT WIX_UPGRADE_DETECTED OR EXISTINGDESKTOPSHORTCUT)" />
    <!-- "Open with SwiftPDF" on PDF files. On for a first install. An update keeps it only while
         SwiftPDF's own menu key is still present. WIX_UPGRADE_DETECTED is this package's
         UpgradeCode, so an installed PdfCraft does not count. -->
    <Property Id="INSTALLOPENWITH" Secure="yes" />
    <Property Id="EXISTINGOPENWITH">
      <RegistrySearch Id="OpenWithSearch" Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\SwiftPDF.Open" Type="raw" />
    </Property>
    <SetProperty Id="INSTALLOPENWITH" Value="1" After="AppSearch" Sequence="first"
        Condition="NOT INSTALLOPENWITH AND (NOT WIX_UPGRADE_DETECTED OR EXISTINGOPENWITH)" />
    <UIRef Id="SwiftPdfInstallerUI" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="SwiftPDF">
        <Directory Id="ModelsFolder" Name="models" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="SwiftPDF" Level="1">
      <ComponentGroupRef Id="SwiftPdfFiles" />
      <ComponentGroupRef Id="SwiftPdfModels" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="SwiftPdfFiles" Directory="INSTALLFOLDER">
      <Component Id="SwiftPdfApp" Guid="55EB12B3-D4D6-41A7-A26F-655E7145AE4F">
        <File Id="SwiftPdfExe" Source="$(var.BinDir)\SwiftPDF.exe" KeyPath="yes" />

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\SwiftPDF.exe" Value="[#SwiftPdfExe]" Type="string" />

        <!-- PDF files: SwiftPDF is offered under "Open with" and in Settings ▸ Default apps.
             .pdf's own default value is left alone, and the user chooses. -->
        <RegistryValue Root="HKLM" Key="Software\Classes\SwiftPDF.Document" Value="PDF Document" Type="string" />
        <!-- A negative index selects the stable icon resource ID, rather than its position.
             Resource 1 is the app icon; resource 2 is the PDF document (build.rs). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\SwiftPDF.Document\DefaultIcon" Value="&quot;[#SwiftPdfExe]&quot;,-2" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SwiftPDF.Document\shell\open\command" Value="&quot;[#SwiftPdfExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.pdf\OpenWithProgids" Name="SwiftPDF.Document" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\SwiftPDF.exe" Name="FriendlyAppName" Value="SwiftPDF" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\SwiftPDF.exe\DefaultIcon" Value="&quot;[#SwiftPdfExe]&quot;,-2" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\SwiftPDF.exe\SupportedTypes" Name=".pdf" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\SwiftPDF.exe\shell\open\command" Value="&quot;[#SwiftPdfExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\SwiftPDF\Capabilities" Name="ApplicationName" Value="SwiftPDF" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\SwiftPDF\Capabilities" Name="ApplicationDescription" Value="View PDF files" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\SwiftPDF\Capabilities" Name="ApplicationIcon" Value="[#SwiftPdfExe],0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\SwiftPDF\Capabilities\FileAssociations" Name=".pdf" Value="SwiftPDF.Document" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="SwiftPDF" Value="Software\SwiftPDF\Capabilities" Type="string" />
      </Component>

      <!-- Shortcuts are plain links to SwiftPDF.exe, not advertised MSI shortcuts. Each has its
           own component with an HKLM key path, so Windows Installer removes it on uninstall. -->
      <Component Id="SwiftPdfStartMenuShortcut" Directory="ProgramMenuFolder" Guid="20020BE4-7332-4EE0-92F9-B0377A83443C">
        <Shortcut Id="StartMenuShortcut" Name="SwiftPDF" Description="SwiftPDF"
            Target="[#SwiftPdfExe]" WorkingDirectory="INSTALLFOLDER" Icon="SwiftPdfIcon.ico" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\SwiftPDF\Shortcuts" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="SwiftPdfDesktopShortcut" Directory="DesktopFolder" Guid="17FDFB9A-B361-4D44-8858-E945FCA9CBBD"
          Condition="INSTALLDESKTOPSHORTCUT = 1">
        <Shortcut Id="DesktopShortcut" Name="SwiftPDF" Description="SwiftPDF"
            Target="[#SwiftPdfExe]" WorkingDirectory="INSTALLFOLDER" Icon="SwiftPdfIcon.ico" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\SwiftPDF\Shortcuts" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- "Open with SwiftPDF" opens the file whichever app is the default for .pdf. On Windows 11
           the entry is under "Show more options". Its own component with an HKLM key path, so
           INSTALLOPENWITH=0 leaves it out and uninstall removes it. -->
      <Component Id="SwiftPdfOpenMenu" Guid="75D5BCA9-EEF3-4B9F-9323-1294CE36D116"
          Condition="INSTALLOPENWITH = 1">
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\SwiftPDF.Open" Value="Open with SwiftPDF" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\SwiftPDF.Open" Name="Icon" Value="&quot;[#SwiftPdfExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\SwiftPDF.Open" Name="MultiSelectModel" Value="Document" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\SwiftPDF.Open\command" Value="&quot;[#SwiftPdfExe]&quot; &quot;%1&quot;" Type="string" />
      </Component>

      <!-- The embedded PDF icon's ISC notice and project licences travel with the binary. -->
      <Component Id="SwiftPdfDocumentIconLicense" Guid="5F98A897-B0FE-4E1F-8D3D-012A09402174">
        <File Id="SwiftPdfDocumentIconLicenseFile" Source="$(var.BinDir)\LICENSE-document.txt" KeyPath="yes" />
      </Component>
      <Component Id="SwiftPdfMitLicense" Guid="BE48E106-A665-488A-A933-92AE1AD7B9B6">
        <File Id="SwiftPdfMitLicenseFile" Source="$(var.BinDir)\LICENSE-MIT" KeyPath="yes" />
      </Component>
      <Component Id="SwiftPdfApacheLicense" Guid="00188FEC-E3C7-4AE3-B89C-7E352122C0B6">
        <File Id="SwiftPdfApacheLicenseFile" Source="$(var.BinDir)\LICENSE-APACHE" KeyPath="yes" />
      </Component>
      <Component Id="SwiftPdfNotice" Guid="AB05D169-73FE-440B-AC2E-302E176BC84C">
        <File Id="SwiftPdfNoticeFile" Source="$(var.BinDir)\NOTICE" KeyPath="yes" />
      </Component>
      <!-- OFL-1.1 licences for the faces embedded in SwiftPDF.exe. Not PdfCraft component ids. -->
      <Component Id="SwiftPdfOflBizUdPgothic" Guid="2D4CED90-02E3-4205-ACCF-92E853E9EB5C">
        <File Id="SwiftPdfOflBizUdPgothicFile" Source="$(var.BinDir)\OFL-biz-ud-pgothic.txt" KeyPath="yes" />
      </Component>
      <Component Id="SwiftPdfOflBizUdMincho" Guid="57CC7233-5B9E-4EC7-84EA-82B4A826C9D3">
        <File Id="SwiftPdfOflBizUdMinchoFile" Source="$(var.BinDir)\OFL-biz-ud-mincho.txt" KeyPath="yes" />
      </Component>
      <Component Id="SwiftPdfOflShipporiMincho" Guid="5D783F96-FC1E-4537-A916-73EE16344071">
        <File Id="SwiftPdfOflShipporiMinchoFile" Source="$(var.BinDir)\OFL-shippori-mincho.txt" KeyPath="yes" />
      </Component>
      <Component Id="SwiftPdfOflNotoSansArabic" Guid="5D11A0C1-A73D-49C8-8D56-829DF5620822">
        <File Id="SwiftPdfOflNotoSansArabicFile" Source="$(var.BinDir)\OFL-noto-sans-arabic.txt" KeyPath="yes" />
      </Component>
      <Component Id="SwiftPdfOflNotoSansThai" Guid="81D5B6E1-6951-4265-B30E-C0A57AA3A1FA">
        <File Id="SwiftPdfOflNotoSansThaiFile" Source="$(var.BinDir)\OFL-noto-sans-thai.txt" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- OCR models, with their licences and ATTRIBUTION.txt, in models\ beside SwiftPDF.exe.
         Each file has its own GUID. A wildcard harvest would reuse WiX's path-based GUID, which
         can match PdfCraft when the file name and directory id are the same. package.ps1 rejects
         a models folder that gains or loses a file, so a new model cannot ship without a new GUID. -->
    <ComponentGroup Id="SwiftPdfModels" Directory="ModelsFolder">
      <Component Id="SwiftPdfModelDetection" Guid="752CA59E-86AB-4006-8206-FCAE51756ADB">
        <File Id="SwiftPdfModelDetectionFile" Source="$(var.ModelsDir)\text-detection.rten" KeyPath="yes" />
      </Component>
      <Component Id="SwiftPdfModelRecognition" Guid="3BD6A1A4-0559-4633-95A7-6ACAF09B2461">
        <File Id="SwiftPdfModelRecognitionFile" Source="$(var.ModelsDir)\text-recognition.rten" KeyPath="yes" />
      </Component>
      <Component Id="SwiftPdfModelDetectionLicense" Guid="A0DFC9B8-82D5-4955-9EF1-C43BA222E8BB">
        <File Id="SwiftPdfModelDetectionLicenseFile" Source="$(var.ModelsDir)\text-detection.rten.LICENCE.txt" KeyPath="yes" />
      </Component>
      <Component Id="SwiftPdfModelRecognitionLicense" Guid="511CE02A-7BF4-463F-B7D9-E72BE1109C00">
        <File Id="SwiftPdfModelRecognitionLicenseFile" Source="$(var.ModelsDir)\text-recognition.rten.LICENCE.txt" KeyPath="yes" />
      </Component>
      <Component Id="SwiftPdfModelAttribution" Guid="1DACAAE2-972E-4274-9F7C-0459C28BDA42">
        <File Id="SwiftPdfModelAttributionFile" Source="$(var.ModelsDir)\ATTRIBUTION.txt" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
